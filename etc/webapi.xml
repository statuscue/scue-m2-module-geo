<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/geo/city" method="GET">
        <service class="Scue\Geo\Api\DictionaryRepositoryInterface" method="getCities" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/geo/ip/city" method="GET">
        <service class="Scue\Geo\Api\CityFetchService" method="getCity" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
</routes>
